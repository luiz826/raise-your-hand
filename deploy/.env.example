# Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- your domain (points at the VPS; Caddy gets HTTPS for it automatically) ---
RYH_DOMAIN=voice.yourdomain.com

# --- LLM (Kimi K3 by default; cheap + strong). Keys are server-side only. ---
MOONSHOT_API_KEY=sk-your-moonshot-key
RYH_QA_MODEL=moonshot:kimi-k3
RYH_INGEST_MODEL=moonshot:kimi-k3
# ANTHROPIC_API_KEY=sk-ant-...        # only if you switch RYH_*_MODEL to an anthropic model

# --- hardening ---
RYH_ALLOWED_ORIGIN=https://www.youtube.com   # lock CORS to the extension's page origin
RYH_API_TOKEN=change-me-to-a-long-random-string   # protects /ingest (maintainer-only)
RYH_ASK_PER_MIN=20                # per-IP question limit
RYH_INGEST_PER_HOUR=5
RYH_LOG_TEXT=0                     # 0 = don't store question/answer text in telemetry

# --- voice ---
RYH_WHISPER_MODEL=small           # CPU-friendly; "medium" is more accurate but slower
RYH_WHISPER_COMPUTE=int8
