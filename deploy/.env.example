# Copy to deploy/.env and fill in. Never commit deploy/.env.

# --- your domain (points at the VPS; Caddy gets HTTPS for it automatically) ---
RYH_DOMAIN=voice.yourdomain.com
# Optional: serve the landing page + privacy policy (deploy/site/) on your apex.
# RYH_SITE_DOMAIN=yourdomain.com, www.yourdomain.com

# --- LLM. Voice needs low latency: Claude Haiku 4.5 answers in ~1s and stays
#     course-aware + spoiler-safe. (Kimi K3's reasoning adds ~15-20s to the first
#     token — unusable for a spoken TA. Sonnet 5 is ~2s + higher quality for ~3x cost.)
#     Keys are server-side only. ---
ANTHROPIC_API_KEY=sk-ant-your-key
RYH_QA_MODEL=claude-haiku-4-5
RYH_INGEST_MODEL=claude-haiku-4-5
OPENAI_API_KEY=sk-...               # used by the STT server (audio transcription)
# MOONSHOT_API_KEY=sk-...             # only if you switch RYH_*_MODEL to moonshot:kimi-*

# --- hardening ---
RYH_ALLOWED_ORIGIN=https://www.youtube.com   # lock CORS to the extension's page origin
RYH_API_TOKEN=change-me-to-a-long-random-string   # protects /ingest (maintainer-only)
RYH_ASK_PER_MIN=20                # per-IP question limit
RYH_INGEST_PER_HOUR=5
RYH_LOG_TEXT=0                     # 0 = don't store question/answer text in telemetry

# --- voice (both STT and TTS use OpenAI — set OPENAI_API_KEY above; no local models) ---
RYH_STT_MODEL=gpt-4o-transcribe   # gpt-4o-mini-transcribe is cheaper and still good
RYH_TTS_MODEL=gpt-4o-mini-tts     # natural, multilingual voice
RYH_TTS_VOICE=alloy               # try onyx/ash/sage/nova/shimmer/echo/fable
