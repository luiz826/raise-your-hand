# Kokoro TTS + Whisper STT (Python, uv-managed). One image; docker-compose runs
# it twice (tts/server.py and stt/server.py). Models are NOT baked — the
# entrypoint downloads Kokoro into a volume; Whisper auto-downloads to the HF
# cache volume on first load. Keeps the image small and models persistent.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

COPY tts ./tts
COPY stt ./stt
COPY deploy/entrypoint-voice.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "tts/server.py"]
