# STT + TTS servers — thin stdlib-only proxies to OpenAI (no local models, no
# third-party deps). docker-compose runs this one image twice (tts + stt).
FROM python:3.11-slim
WORKDIR /app

COPY tts ./tts
COPY stt ./stt
COPY deploy/entrypoint-voice.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && useradd -m -u 1000 app && chown -R app:app /app
USER app

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "tts/server.py"]
