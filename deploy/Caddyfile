# One domain, path-routed. Caddy fetches + renews a TLS cert automatically.
# /tts and /stt go to the voice servers (rate-limited per client IP so nobody
# can hammer the paid OpenAI voice endpoints); everything else (/ask, /course,
# /ingest, /feedback, /heartbeat, /health) goes to the backend.
{
	order rate_limit before reverse_proxy
}

{$RYH_DOMAIN} {
	encode zstd gzip

	handle /tts* {
		rate_limit {
			zone tts {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy tts:8788
	}
	handle /stt* {
		rate_limit {
			zone stt {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy stt:8789
	}
	handle {
		reverse_proxy backend:8787
	}
}
