# One domain, path-routed. Caddy fetches + renews a TLS cert automatically.
# /tts and /stt go to the voice servers (rate-limited per client IP so nobody
# can hammer the paid OpenAI voice endpoints). /ingest and /ask are also
# rate-limited: both spend Anthropic credits, and /ingest is public + expensive
# (a full course build), so it's capped hard per IP. /illustrate and
# /realtime-session also spend money (gpt-image-1 / OpenAI Realtime) and get
# per-IP hourly zones. Everything else (/course, /feedback, /heartbeat,
# /health) goes to the backend unthrottled, where the app's own per-IP limits
# apply. Every proxy hop OVERWRITES X-Forwarded-For with the real client IP —
# the backend trusts that header for its per-IP rate limits, so a client must
# never be able to smuggle their own value through.
{
	order rate_limit before reverse_proxy
}

{$RYH_DOMAIN} {
	encode zstd gzip

	handle /tts* {
		rate_limit {
			zone tts {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy tts:8788
	}
	handle /stt* {
		rate_limit {
			zone stt {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy stt:8789
	}
	handle /ingest* {
		rate_limit {
			zone ingest {
				key {remote_host}
				events 5
				window 1h
			}
		}
		reverse_proxy backend:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /ask* {
		rate_limit {
			zone ask {
				key {remote_host}
				events 30
				window 1m
			}
		}
		reverse_proxy backend:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /illustrate* {
		rate_limit {
			zone illustrate {
				key {remote_host}
				events 10
				window 1h
			}
		}
		reverse_proxy backend:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /realtime-session* {
		rate_limit {
			zone live {
				key {remote_host}
				events 10
				window 1h
			}
		}
		reverse_proxy backend:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy backend:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Landing page + privacy policy on the apex (and www). Static files, auto-HTTPS.
# RYH_SITE_DOMAIN can list several addresses, e.g. "example.com, www.example.com".
{$RYH_SITE_DOMAIN:localhost} {
	encode zstd gzip
	root * /srv/site
	try_files {path} {path}.html {path}/index.html
	file_server
}
