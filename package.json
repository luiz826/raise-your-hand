{
  "name": "raise-your-hand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "ask": "tsx src/ask.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/eval.ts",
    "server": "tsx src/server.ts",
    "stats": "tsx scripts/stats.ts",
    "icons": "tsx scripts/make-icons.ts",
    "pack:ext": "rm -f raise-your-hand-extension.zip && cd extension && zip -rq ../raise-your-hand-extension.zip . -x \"*.DS_Store\" && cd .. && echo wrote raise-your-hand-extension.zip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
