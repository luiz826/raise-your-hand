{
  "manifest_version": 3,
  "name": "Raise Your Hand",
  "version": "0.2.0",
  "description": "Pause a YouTube university lecture and ask a course-aware teaching assistant that knows the whole playlist.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Raise Your Hand — pause a lecture and press Shift+A to ask",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.raise-your-hand.cloud/*",
    "http://localhost:8787/*",
    "http://localhost:8788/*",
    "http://localhost:8789/*",
    "*://www.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/*",
        "vendor/wasm/*"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
